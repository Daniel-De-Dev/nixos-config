# Carbon Gray 100 inspired defaults. Application adapters consume semantic roles.
{
  colors = {
    background = "#161616";
    surface = "#262626";
    surfaceHover = "#333333";
    surfaceSelected = "#393939";
    surfaceActive = "#525252";
    text = "#f4f4f4";
    textMuted = "#c6c6c6";
    border = "#393939";
    borderStrong = "#6f6f6f";
    accent = "#4589ff";
    focus = "#ffffff";
